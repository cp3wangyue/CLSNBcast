# ===== CLSNBcast 环境变量模板 =====
# 复制为 .env 并填写真实值

# ===== 部署 =====

# 对外域名（Caddy 自动签发 HTTPS 证书）。
# ⚠️ 屏幕采集需要 HTTPS，生产环境必须设置真实域名并通过 https:// 访问。
DOMAIN=share.example.com

# 服务端口（应用容器内监听端口，默认 3520；由 Caddy 代理，一般无需改动）
PORT=3520

# 超级管理员密码（必填，未设置则服务拒绝启动）
SUPER_ADMIN_PASSWORD=

# CORS 允许的额外域名（可选，逗号分隔。不设则仅允许本地开发域名）
# ALLOWED_ORIGINS=https://custom-domain.com,https://other-domain.com

# KOOK HTTP API 请求超时（毫秒）
KOOK_API_TIMEOUT_MS=10000

# 秘密加密主密钥（AES-256-GCM 主密钥，32 字节）
# 用于加密存储 Agora App Certificate / Customer Secret 等敏感数据。
# 未设置时服务仍可启动，但一旦库中已存在加密数据，启动会直接失败退出。
# 生成：openssl rand -hex 32
# ⚠️ 生成后务必妥善备份：丢失该密钥将无法解密库中已存的凭证。
SECRET_ENCRYPTION_KEY=

# 数据目录（可选）。默认 <工作目录>/data，SQLite 文件为 <数据目录>/clsnbcast.db
# 容器内已通过命名卷映射到 /app/data，一般无需设置。
# DATA_DIR=/app/data
