# ===== CLSNBcast 环境变量模板 =====
# 复制为 .env 并填写真实值

# ===== 部署 =====

# 对外域名（Caddy 自动签发 HTTPS 证书）。
# ⚠️ 屏幕采集与 Agora Web SDK 都要求安全上下文，生产环境必须通过 https:// 访问。
# 没有域名时可用自签证书，见 DEPLOY.md「Windows Server 原生部署」。
DOMAIN=share.example.com

# 服务端口（应用容器内监听端口，默认 3520；由 Caddy 代理，一般无需改动）
PORT=3520

# 是否信任反向代理（可选）。不设 = 信任一跳代理，适用于本仓库默认的 Caddy/nginx 反代部署。
# ⚠️ 直接暴露应用（前面没有反向代理）时必须设为 false：
#    否则客户端可伪造 X-Forwarded-For 绕过登录/绑定接口的按 IP 限流。
# TRUST_PROXY=false

# 超级管理员密码（必填，未设置则服务拒绝启动）
SUPER_ADMIN_PASSWORD=

# CORS 允许的额外域名（可选，逗号分隔。不设则仅允许本地开发域名）
# ALLOWED_ORIGINS=https://custom-domain.com,https://other-domain.com

# KOOK HTTP API 请求超时（毫秒）
KOOK_API_TIMEOUT_MS=10000

# KOOK Bot Token（可选）。仅用于首次建库/升级时播种 kookBotToken，
# 库中已有值则不会覆盖。也可稍后在超管面板「全局配置」中填写。
# KOOK_BOT_TOKEN=

# 旧版管理员入口的停用时间（可选，ISO 8601 或可被 Date.parse 解析的字符串）。
# 不设或无法解析时默认取「首次建库时间 + 30 天」。仅影响旧入口的提示，不影响登录。
# LEGACY_ADMIN_SUNSET_AT=

# 秘密加密主密钥（AES-256-GCM 主密钥，32 字节）
# 用于加密存储 Agora App Certificate / Customer Secret 等敏感数据。
# 未设置时服务仍可启动，但一旦库中已存在加密数据，启动会直接失败退出。
# 生成：openssl rand -hex 32
# ⚠️ 生成后务必妥善备份：丢失该密钥将无法解密库中已存的凭证。
SECRET_ENCRYPTION_KEY=

# 数据目录（可选）。默认 <工作目录>/data，SQLite 文件为 <数据目录>/clsnbcast.db
# 容器内已通过命名卷映射到 /app/data，一般无需设置。
# DATA_DIR=/app/data
